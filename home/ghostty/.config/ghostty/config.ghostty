# ================================================================
# Ghostty Configuration
# Alacritty.toml 対応版
# ================================================================


# Config generated by Ghostty Config

clipboard-read = allow
clipboard-write = allow
window-subtitle = working-directory
background-opacity = 0.75
background-blur = true

# ------------------------------------------------
# Window
# ------------------------------------------------
window-height = 28
window-width = 90
window-colorspace = srgb
window-padding-x = 8
window-padding-y = 6

# ------------------------------------------------
# Colors
# ------------------------------------------------
theme = TokyoNight Night
background = #1a1b26
foreground = #c0caf5
selection-background = #283457
selection-foreground = #c0caf5
cursor-color = #c0caf5
cursor-text = #1a1b26
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# ------------------------------------------------
# Font
# ------------------------------------------------
font-size = 14
font-family = HackGen Console NF
font-synthetic-style = true

# ------------------------------------------------
# Scrolling
# ------------------------------------------------
scrollback-limit = 10000

# ------------------------------------------------
# Selection / Clipboard
# ------------------------------------------------
copy-on-select = true


# ------------------------------------------------
# Mouse
# ------------------------------------------------
mouse-hide-while-typing = true

# ------------------------------------------------
# Keyboard
# ------------------------------------------------
# F11: フルスクリーン
keybind = f11=toggle_fullscreen

# Ctrl+Shift+T: 新しいウィンドウ（tmux 推奨なので控えめ）
# keybind = ctrl+shift+t=new_window

gtk-titlebar = false

custom-shader = ~/.config/ghostty/shaders/water.glsl
